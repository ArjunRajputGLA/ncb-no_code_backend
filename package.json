{
  "name": "my-electron-app",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "build": {
    "appId": "com.example.my-electron-app",
    "mac": {
      "category": "public.app-category.productivity"
    },
    "files": [
      "electron/**/*",
      "out/**/*",
      "package.json"
    ]
  },
  "scripts": {
    "dev": "concurrently \"cross-env NODE_ENV=development next dev\" \"wait-on http://localhost:3000 && cross-env NODE_ENV=development electron .\"",
    "build": "next build && next export",
    "start": "next start",
    "electron:build": "electron-builder"
  },
  "dependencies": {
    "@types/lokijs": "^1.5.14",
    "fs-extra": "^11.3.1",
    "lokijs": "^1.5.12",
    "lowdb": "^7.0.1",
    "lucide-react": "^0.539.0",
    "next": "^15.5.2",
    "node-fetch": "^3.3.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "reactflow": "^11.11.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.0",
    "cross-env": "^10.0.0",
    "electron": "^37.3.0",
    "electron-builder": "^26.0.12",
    "eslint": "^9",
    "eslint-config-next": "15.4.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^8.0.4"
  }
}
